// --- Servidor ---
PORT=3000
NODE_ENV=development

// --- Supabase (stack local: obtener valores con `supabase status`) ---
// IMPORTANTE: conectar como app_bff (no postgres) para que RLS aplique.
DATABASE_URL=postgresql://app_bff:app_bff_dev_password@localhost:54322/postgres

// --- Autenticación ---
JWT_SECRET=dev-secret-unsigned-change-me
JWT_EXPIRES_IN=8h

// --- Supabase Storage (solo BFF accede; el cliente usa URLs firmadas) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_key_xxx

// --- Notificaciones Push ---
// 'mock' para desarrollo --- 'expo' llama a la Expo Push API real.
PUSH_PROVIDER=mock

// --- Sistema a sistema (Paso 5) ---
// API Key requerida por los endpoints /sistema/* (ej. POST /sistema/notas).
// Generar con un secreto aleatorio en producción y rotarlo periódicamente.
SISTEMA_API_KEY=dev-sistema-api-key-change-me

// --- UNIMAR (Paso 5) ---
// Si UNIMAR_API_URL está vacía, el módulo Académico usa el Mock interno.
// Si está presente, `ApiUniversityAcademicService` hace fetch real.
UNIMAR_API_URL=
UNIMAR_API_KEY=
